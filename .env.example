# ==========================================
# Travel Route Planning AI Agent Environment
# ==========================================

# Groq API Key (Get a free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (Get a free key from https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Default Model for Groq (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Backend Port (default: 8000)
BACKEND_PORT=8000
